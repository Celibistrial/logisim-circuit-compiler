circuit dp_compare_stage:
  inputs LTin, EQin, GTin, A, B
  outputs LTout, EQout, GTout
  different = A ^ B
  same = ~different
  not_a = ~A
  not_b = ~B
  a_lt_b = not_a & B
  a_gt_b = A & not_b
  lt_here = EQin & a_lt_b
  gt_here = EQin & a_gt_b
  LTout = LTin | lt_here
  EQout = EQin & same
  GTout = GTin | gt_here

circuit dp_mux2:
  inputs D0, D1, S
  outputs Y
  not_s = ~S
  choose_0 = D0 & not_s
  choose_1 = D1 & S
  Y = choose_0 | choose_1

circuit compare8:
  inputs A0, A1, A2, A3, A4, A5, A6, A7, B0, B1, B2, B3, B4, B5, B6, B7
  outputs LT, EQ, GT
  use dp_compare_stage bit7(LTin=0, EQin=1, GTin=0, A=A7, B=B7) -> (LTout=_lt7, EQout=_eq7, GTout=_gt7)
  use dp_compare_stage bit6(LTin=_lt7, EQin=_eq7, GTin=_gt7, A=A6, B=B6) -> (LTout=_lt6, EQout=_eq6, GTout=_gt6)
  use dp_compare_stage bit5(LTin=_lt6, EQin=_eq6, GTin=_gt6, A=A5, B=B5) -> (LTout=_lt5, EQout=_eq5, GTout=_gt5)
  use dp_compare_stage bit4(LTin=_lt5, EQin=_eq5, GTin=_gt5, A=A4, B=B4) -> (LTout=_lt4, EQout=_eq4, GTout=_gt4)
  use dp_compare_stage bit3(LTin=_lt4, EQin=_eq4, GTin=_gt4, A=A3, B=B3) -> (LTout=_lt3, EQout=_eq3, GTout=_gt3)
  use dp_compare_stage bit2(LTin=_lt3, EQin=_eq3, GTin=_gt3, A=A2, B=B2) -> (LTout=_lt2, EQout=_eq2, GTout=_gt2)
  use dp_compare_stage bit1(LTin=_lt2, EQin=_eq2, GTin=_gt2, A=A1, B=B1) -> (LTout=_lt1, EQout=_eq1, GTout=_gt1)
  use dp_compare_stage bit0(LTin=_lt1, EQin=_eq1, GTin=_gt1, A=A0, B=B0) -> (LTout=LT, EQout=EQ, GTout=GT)

circuit minmax8_compare:
  inputs A0, A1, A2, A3, A4, A5, A6, A7, B0, B1, B2, B3, B4, B5, B6, B7
  outputs LT, EQ, GT
  use dp_compare_stage bit7(LTin=0, EQin=1, GTin=0, A=A7, B=B7) -> (LTout=_lt7, EQout=_eq7, GTout=_gt7)
  use dp_compare_stage bit6(LTin=_lt7, EQin=_eq7, GTin=_gt7, A=A6, B=B6) -> (LTout=_lt6, EQout=_eq6, GTout=_gt6)
  use dp_compare_stage bit5(LTin=_lt6, EQin=_eq6, GTin=_gt6, A=A5, B=B5) -> (LTout=_lt5, EQout=_eq5, GTout=_gt5)
  use dp_compare_stage bit4(LTin=_lt5, EQin=_eq5, GTin=_gt5, A=A4, B=B4) -> (LTout=_lt4, EQout=_eq4, GTout=_gt4)
  use dp_compare_stage bit3(LTin=_lt4, EQin=_eq4, GTin=_gt4, A=A3, B=B3) -> (LTout=_lt3, EQout=_eq3, GTout=_gt3)
  use dp_compare_stage bit2(LTin=_lt3, EQin=_eq3, GTin=_gt3, A=A2, B=B2) -> (LTout=_lt2, EQout=_eq2, GTout=_gt2)
  use dp_compare_stage bit1(LTin=_lt2, EQin=_eq2, GTin=_gt2, A=A1, B=B1) -> (LTout=_lt1, EQout=_eq1, GTout=_gt1)
  use dp_compare_stage bit0(LTin=_lt1, EQin=_eq1, GTin=_gt1, A=A0, B=B0) -> (LTout=LT, EQout=EQ, GTout=GT)

circuit minmax8_mux:
  inputs D00, D01, D02, D03, D04, D05, D06, D07, D10, D11, D12, D13, D14, D15, D16, D17, S
  outputs Y0, Y1, Y2, Y3, Y4, Y5, Y6, Y7
  use dp_mux2 bit0(D0=D00, D1=D10, S=S) -> (Y=Y0)
  use dp_mux2 bit1(D0=D01, D1=D11, S=S) -> (Y=Y1)
  use dp_mux2 bit2(D0=D02, D1=D12, S=S) -> (Y=Y2)
  use dp_mux2 bit3(D0=D03, D1=D13, S=S) -> (Y=Y3)
  use dp_mux2 bit4(D0=D04, D1=D14, S=S) -> (Y=Y4)
  use dp_mux2 bit5(D0=D05, D1=D15, S=S) -> (Y=Y5)
  use dp_mux2 bit6(D0=D06, D1=D16, S=S) -> (Y=Y6)
  use dp_mux2 bit7(D0=D07, D1=D17, S=S) -> (Y=Y7)

circuit minmax8:
  inputs A0, A1, A2, A3, A4, A5, A6, A7, B0, B1, B2, B3, B4, B5, B6, B7
  outputs MIN0, MIN1, MIN2, MIN3, MIN4, MIN5, MIN6, MIN7, MAX0, MAX1, MAX2, MAX3, MAX4, MAX5, MAX6, MAX7
  use minmax8_compare compare(A0=A0, A1=A1, A2=A2, A3=A3, A4=A4, A5=A5, A6=A6, A7=A7, B0=B0, B1=B1, B2=B2, B3=B3, B4=B4, B5=B5, B6=B6, B7=B7) -> (LT=_a_lt_b, EQ=_equal, GT=_a_gt_b)
  use minmax8_mux minimum(D00=B0, D01=B1, D02=B2, D03=B3, D04=B4, D05=B5, D06=B6, D07=B7, D10=A0, D11=A1, D12=A2, D13=A3, D14=A4, D15=A5, D16=A6, D17=A7, S=_a_lt_b) -> (Y0=MIN0, Y1=MIN1, Y2=MIN2, Y3=MIN3, Y4=MIN4, Y5=MIN5, Y6=MIN6, Y7=MIN7)
  use minmax8_mux maximum(D00=A0, D01=A1, D02=A2, D03=A3, D04=A4, D05=A5, D06=A6, D07=A7, D10=B0, D11=B1, D12=B2, D13=B3, D14=B4, D15=B5, D16=B6, D17=B7, S=_a_lt_b) -> (Y0=MAX0, Y1=MAX1, Y2=MAX2, Y3=MAX3, Y4=MAX4, Y5=MAX5, Y6=MAX6, Y7=MAX7)
