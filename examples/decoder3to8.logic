# 3-to-8 decoder: Yn = 1 iff {A2 A1 A0} == n
circuit decoder3to8:
  inputs A2, A1, A0
  outputs Y0, Y1, Y2, Y3, Y4, Y5, Y6, Y7
  nA2 = ~A2
  nA1 = ~A1
  nA0 = ~A0
  Y0 = nA2 & nA1 & nA0
  Y1 = nA2 & nA1 & A0
  Y2 = nA2 & A1 & nA0
  Y3 = nA2 & A1 & A0
  Y4 = A2 & nA1 & nA0
  Y5 = A2 & nA1 & A0
  Y6 = A2 & A1 & nA0
  Y7 = A2 & A1 & A0
